# Only the files copied by Dockerfile.test should enter the build context.
*
!Dockerfile.test
!.dockerignore
!pyproject.toml
!MANIFEST.in
!uv.lock
!README.md
!LICENSE
!VERSION
!bbackup.py
!bbman.py
!bbackup/
!bbackup/**
!tests/
!tests/**
!scripts/
!scripts/**
!docs/
!docs/**
!packaging/
!packaging/**
!.github/
!.github/**

# Keep private and generated files excluded even inside allowed source trees.
.git/
.venv/
venv/
env/
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
htmlcov/
**/__pycache__/
**/*.py[cod]

# Local agent, editor, and runtime state.
.agent/
.agents/
.codex/
.localsetup/
_localsetup/
.localsetup-maint/
.cursor/
.idea/
.vscode/
maintenance/
state/
tmp/
logs/
*.log
*.tmp
*.backup
backup_*/
*.tar
*.tar.*
*.zip
*.db
*.sqlite*

# Local credentials and private configuration.
**/.env
**/.env.*
**/*.pem
**/*.key
**/client_secret*.json
config.yaml
config.yml

# GitHub workflow metadata is portable and used by repository checks.
