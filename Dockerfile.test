FROM docker.io/library/python:3.12.15-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN apt-get update \
    && apt-get install -y curl rsync docker.io \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY .github/uv-bootstrap.txt .github/uv-bootstrap.txt
RUN python -m pip install --no-cache-dir --require-hashes -r .github/uv-bootstrap.txt
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project
COPY bbackup/ bbackup/
COPY bbackup.py bbman.py ./
COPY README.md LICENSE VERSION MANIFEST.in ./
RUN uv sync --locked
COPY tests/ tests/
COPY scripts/ scripts/
COPY docs/ docs/
COPY packaging/ packaging/
COPY .github/ .github/
