#!/bin/sh
set -eu

PENDING_PATH='@PENDING_PATH@'

case "${1-}" in
    remove|purge)
        if [ -e "$PENDING_PATH" ] || [ -L "$PENDING_PATH" ]; then
            rm -f -- "$PENDING_PATH"
        fi
        ;;
    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        # Preserve the marker after incomplete transactions; dpkg repair must configure successfully.
        ;;
    *) printf 'bbackup postrm: unsupported dpkg action: %s\n' "${1-<missing>}" >&2; exit 1 ;;
esac
